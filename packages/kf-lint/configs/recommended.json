{
  "extendsRecommended": true,
  "ignore": ["**/node_modules/**", "**/dist/**", "**/.git/**"],
  "rules": {
    "skill/frontmatter-required": "error",
    "skill/name-kebab-case": "error",
    "skill/name-directory-match": "error",
    "skill/name-prefix": "error",
    "commit/japanese-prefix-format": "error",
    "markdown/ordered-list-one": "error",
    "markdown/no-numbered-heading": "error",
    "docker/layer-heading": "warn",
    "sveltekit/no-server-import-in-browser": "error",
    "sveltekit/no-route-import-in-components": "error",
    "sveltekit/no-svelte-import-in-server": "error",
    "svelte/require-each-key": "error",
    "svelte/no-legacy-syntax": "error",
    "css/no-vw-vh": "error",
    "css/no-flex-column": "error",
    "css/no-transition-all": "error",
    "css/keyframes-dashed-ident": "error",
    "css/no-unnamed-container": "error",
    "css/container-name-prefix": "error",
    "css/no-var-in-query-condition": "error",
    "css/no-legacy-media-range": "error",
    "css/no-sp-pc-only-class": "error",
    "css/no-grid-empty-dot": "error",
    "css/no-adjacent-sibling-margin": "error",
    "css/no-line-height-one": "error",
    "css/no-text-justify": "error",
    "css/no-root-font-size-px": "error",
    "css/no-root-font-size-625": "error",
    "css/no-enabled-hover": "warn",
    "css/no-functional-animation-duration": "warn",
    "content/url-reachable": "warn"
  }
}
