{
  "version": 1,
  "hooks": {
    "afterAgentResponse": [
      {
        "command": "./hooks/ai-ja-readability/ja-rewrite.py",
        "timeout": 60
      }
    ],
    "afterFileEdit": [
      {
        "command": "./hooks/ai-ja-readability/ja-rewrite.py",
        "timeout": 60
      }
    ],
    "afterTabFileEdit": [
      {
        "command": "./hooks/ai-ja-readability/ja-rewrite.py",
        "timeout": 60
      }
    ]
  }
}
