{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 ./hooks/ai-ja-readability/ai-ja-readability-session-env.py"
      }
    ],
    "afterAgentResponse": [
      {
        "command": "./hooks/ai-ja-readability/ja-rewrite.py",
        "timeout": 60
      }
    ],
    "afterFileEdit": [
      {
        "command": "./hooks/ai-ja-readability/ja-rewrite.py",
        "timeout": 60
      }
    ],
    "afterTabFileEdit": [
      {
        "command": "./hooks/ai-ja-readability/ja-rewrite.py",
        "timeout": 60
      }
    ]
  }
}
